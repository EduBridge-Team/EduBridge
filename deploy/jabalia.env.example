# Copy to edubridge-api-laravel/.env.jabalia on the server.
# NEVER commit the real file. Generate unique secrets for Jabalia; do not reuse
# EduBridge production APP_KEY, JWT_SECRET, DB_PASSWORD, or storage credentials.

APP_NAME="Jabalia Rehabilitation Society"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jabalia.edubridge.win
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=edubridge-jabalia-postgres
DB_PORT=5432
DB_DATABASE=edubridge_jabalia
DB_USERNAME=edubridge_jabalia
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Separate authentication secret: EduBridge JWTs must not validate here.
JWT_SECRET=

# Optional: configure a separate OAuth client whose authorized origin includes
# https://jabalia.edubridge.win. Leaving this empty disables Google login.
GOOGLE_CLIENT_ID=

# Noor may use the same provider account if desired, but a dedicated key makes
# tenant usage and rotation clearer.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Prefer dedicated Jabalia buckets/prefixes when file upload is enabled.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
R2_PRIVATE_BUCKET=edubridge-jabalia-private
R2_MEDIA_BUCKET=edubridge-jabalia-media
R2_MEDIA_PUBLIC_URL=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@edubridge.win"
MAIL_FROM_NAME="جمعية جباليا للتأهيل"
